# Convex — Claw Picker cloud DB (NEXGEN BACK TO SCHOOL RAFFLE)
# The pool button loads/saves lists from this Convex deployment.
# For Vercel: set this in the Vercel dashboard (Settings → Environment Variables)
# and redeploy. Preview deployment (current live):
VITE_CONVEX_URL="https://bright-mink-448.convex.cloud"
VITE_CONVEX_SITE_URL="https://bright-mink-448.convex.site"
# Production (when you create a prod deploy key): https://quixotic-ant-66.convex.cloud

# Pool passcode — default is nexgen2026 (stored hashed in Convex `app` table)
# No env needed; enter it in the pool panel to unlock cloud saves.

# GEMINI_API_KEY: Required for Gemini AI API calls (optional for claw picker).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
